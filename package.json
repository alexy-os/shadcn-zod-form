{
	"name": "shadcn-zod-form-builder",
	"version": "0.0.1",
	"description": "Generate shadcn/ui forms from zod schemas with Bun.js support",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"author": {
		"name": "alexy-os",
		"url": "https://github.com/alexy-os"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/alexy-os/shadcn-zod-form-builder.git"
	},
	"keywords": [
		"shadcn",
		"zod",
		"form",
		"ui",
		"cli",
		"react",
		"bun"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"bin": {
		"shadcn-zod-form-builder": "./dist/index.js"
	},
	"engines": {
		"node": ">=16.0.0"
	},
	"scripts": {
		"dev": "tsup src/index.ts --watch --clean --format=esm,cjs --dts --sourcemap",
		"build": "tsup src/index.ts --clean --format=esm,cjs --dts --sourcemap --minify",
		"typecheck": "tsc --noEmit",
		"lint": "bunx @biomejs/biome check src",
		"format": "bunx @biomejs/biome format --write src",
		"test:examples": "bun run examples/test.ts",
		"prepublishOnly": "bun run build"
	},
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "1.8.3",
		"@changesets/changelog-github": "^0.5.0",
		"@changesets/cli": "^2.27.8",
		"@types/fs-extra": "^11.0.4",
		"@types/lodash.camelcase": "^4.3.9",
		"@types/lodash.kebabcase": "^4.1.9",
		"@types/lodash.startcase": "^4.4.9",
		"@types/lodash.template": "^4.5.3",
		"@types/node": "^22.5.4",
		"@types/prompts": "^2.4.9",
		"bun-types": "latest",
		"tsup": "^8.3.5",
		"type-fest": "^4.26.1",
		"typescript": "^5.5.4"
	},
	"dependencies": {
		"chalk": "^5.3.0",
		"commander": "^12.1.0",
		"cosmiconfig": "^9.0.0",
		"fs-extra": "^11.2.0",
		"lodash.camelcase": "^4.3.0",
		"lodash.kebabcase": "^4.1.1",
		"lodash.startcase": "^4.4.0",
		"lodash.template": "^4.5.0",
		"ora": "^8.1.0",
		"prompts": "^2.4.2",
		"ts-morph": "^23.0.0",
		"tsconfig-paths": "^4.2.0",
		"zod": "^3.23.8"
	}
}
