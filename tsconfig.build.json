{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"outDir": "dist",
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": true,
		"noEmit": false,
		"module": "ESNext",
		"moduleResolution": "bundler"
	},
	"include": ["src/index.ts"],
	"exclude": ["node_modules", "dist", "examples"]
} 